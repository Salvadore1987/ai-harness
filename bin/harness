#!/usr/bin/env bash
# Launcher for the harness CLI, a native executable (ADR-002).
# Build it first: ./gradlew :harness-bootstrap:nativeCompile
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BINARY="${HARNESS_BINARY:-$SCRIPT_DIR/../harness-bootstrap/build/native/nativeCompile/harness}"

if [[ ! -x "$BINARY" ]]; then
  echo "harness executable not found at $BINARY; run ./gradlew :harness-bootstrap:nativeCompile" >&2
  exit 1
fi

exec "$BINARY" "$@"
